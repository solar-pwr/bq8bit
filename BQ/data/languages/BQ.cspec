<?xml version="1.0" encoding="UTF-8"?>

<!-- TODO: setup a valid cspec file -->
<compiler_spec>
	<global>
		<range space="CODE"/>
		<range space="DATA"/>
	</global>
	<stackpointer register="SP" space="DATA" growth="negative"/>

<!--        <returnaddress>
                <varnode space="stack" offset="0" size="2"/>
        </returnaddress>-->

	<default_proto>
		<prototype name="__stdcall" extrapop="0" stackshift="0">
			<input>
				<pentry minsize="1" maxsize="2">
					<register name="R1"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R2"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R3"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R4"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R5"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R6"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R7"/>
				</pentry>
			</input>
			<output>
				<pentry minsize="1" maxsize="2">
					<register name="R1"/>
				</pentry>
				<pentry minsize="1" maxsize="2">
					<register name="R2"/>
				</pentry>
			</output>
			<unaffected>
				<register name="R7"/>
				<register name="SP"/>
			</unaffected>
		</prototype>
	</default_proto>
</compiler_spec>
