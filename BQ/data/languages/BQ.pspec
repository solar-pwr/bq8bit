<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
	<programcounter register="PC"/>
	<default_symbols>
		<symbol name="START" address="CODE:0x0" entry="true" type="code_ptr"/>
		<symbol name="INT1" address="CODE:0x2" type="code_ptr"/>
		<symbol name="INT2" address="CODE:0x4" type="code_ptr"/>
		<symbol name="INT3" address="CODE:0x6" type="code_ptr"/>
		<symbol name="INT4" address="CODE:0x8" type="code_ptr"/>
	</default_symbols>
	<default_memory_blocks>
		<memory_block name="ram" start_address="DATA:0" length="0x4000" initialized="false"/>
		<memory_block name="sfr" start_address="DATA:0x8000" length="0x4000" initialized="false"/>
		<memory_block name="macros" start_address="CODE:0xff00" length="0x100" initialized="false"/>
	</default_memory_blocks>
</processor_spec>
